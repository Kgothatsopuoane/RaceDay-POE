@{
    ViewData["Title"] = "RaceDay Home";
}

<section class="home-hero">
    <div class="container">
        <div class="row align-items-center min-vh-75">
            <div class="col-lg-7">
                <span class="hero-label">YOUR RACE. YOUR JOURNEY.</span>

                <h1 class="hero-title">
                    PUSH YOUR<br />
                    <span>LIMITS.</span><br />
                    OWN YOUR RACE.
                </h1>

                <p class="hero-description">
                    Discover sporting events, register for races,
                    manage competitions and track your results — all in one place.
                </p>

                <div class="d-flex flex-wrap gap-3 mt-4">
                    <a asp-controller="Account"
                       asp-action="Register"
                       class="btn btn-primary btn-lg">
                        GET STARTED
                    </a>

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-outline-light btn-lg">
                        SIGN IN
                    </a>
                </div>
            </div>

            <div class="col-lg-5 mt-5 mt-lg-0">
                <div class="hero-feature-card">
                    <div class="hero-runner-icon">🏃</div>
                    <p class="hero-card-label">READY. SET. GO.</p>
                    <h2>Every finish line starts with a first step.</h2>
                    <div class="orange-line"></div>
                    <p class="text-muted mb-0">
                        Find your next challenge with RaceDay.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container home-features">
    <div class="text-center mb-5">
        <span class="section-label">WHAT YOU CAN DO</span>
        <h2 class="section-heading">YOUR RACE, MANAGED.</h2>
        <p class="text-muted">
            Everything you need for your sporting journey.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="feature-card h-100">
                <div class="feature-icon">🏁</div>
                <h3>Discover Events</h3>
                <p>
                    Explore sporting events and find a race
                    that matches your goals.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="feature-card h-100">
                <div class="feature-icon">📝</div>
                <h3>Register & Participate</h3>
                <p>
                    Enrol in events, choose your category
                    and get ready to compete.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="feature-card h-100">
                <div class="feature-icon">🏆</div>
                <h3>Track Results</h3>
                <p>
                    Keep track of your race results,
                    finishing positions and achievements.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="container api-status-section">
    <div class="api-status-card">
        <div>
            <span class="section-label">SYSTEM STATUS</span>
            <h3 class="mb-1">RaceDay API Connection</h3>
            <p class="text-muted mb-0">
                @ViewBag.ApiStatus
            </p>
        </div>

        <div class="api-status-icon">●</div>
    </div>
</section>
