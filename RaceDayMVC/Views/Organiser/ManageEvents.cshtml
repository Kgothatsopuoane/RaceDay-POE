@model List<RaceDayMVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Manage Events";
}

<div class="container mt-5">

    <h1>Manage Events</h1>

    <p class="text-muted">
        View and manage your sporting events.
    </p>

    <a asp-controller="Organiser"
       asp-action="Dashboard"
       class="btn btn-secondary mb-3">
        Back to Dashboard
    </a>

    <a asp-controller="Organiser"
       asp-action="CreateEvent"
       class="btn btn-success mb-3">
        + Create New Event
    </a>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You have not created any events yet.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-striped">

                <thead class="table-dark">
                    <tr>
                        <th>Event Name</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Distance</th>
                        <th>Event Type</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.EventName</td>

                            <td>
                                @item.EventDate.ToString("dd/MM/yyyy")
                            </td>

                            <td>@item.Location</td>

                            <td>@item.DistanceKm km</td>

                            <td>@item.EventType</td>

                            <td>
                                <a asp-controller="Organiser"
                                   asp-action="EditEvent"
                                   asp-route-id="@item.EventId"
                                   class="btn btn-warning btn-sm">
                                    Edit
                                </a>

                                <form asp-controller="Organiser"
                                      asp-action="DeleteEvent"
                                      asp-route-id="@item.EventId"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete this event?');">

                                    <button type="submit"
                                            class="btn btn-danger btn-sm">
                                        Delete
                                    </button>

                                </form>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>
