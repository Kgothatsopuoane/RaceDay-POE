@model RaceDayMVC.Models.EventViewModel

@{
    ViewData["Title"] = "Edit Event";
}

<div class="container mt-5 mb-5">

    <h1>Edit Event</h1>

    <p class="text-muted">
        Update your sporting event details.
    </p>

    <a asp-controller="Organiser"
       asp-action="ManageEvents"
       class="btn btn-secondary mb-3">
        Back to Events
    </a>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    <div class="card shadow p-4">

        <form asp-controller="Organiser"
              asp-action="EditEvent"
              asp-route-id="@Model.EventId"
              method="post"
              enctype="multipart/form-data">

            <input type="hidden" asp-for="EventId" />
            <input type="hidden" asp-for="OrganiserId" />

            <div class="mb-3">
                <label asp-for="EventName" class="form-label">
                    Event Name
                </label>
                <input asp-for="EventName"
                       class="form-control"
                       required />
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">
                    Description
                </label>
                <textarea asp-for="Description"
                          class="form-control"
                          rows="3"
                          required></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="EventDate" class="form-label">
                    Event Date
                </label>
                <input asp-for="EventDate"
                       type="datetime-local"
                       asp-format="{0:yyyy-MM-ddTHH:mm}"
                       class="form-control"
                       required />
            </div>

            <div class="mb-3">
                <label asp-for="Location" class="form-label">
                    Location
                </label>
                <input asp-for="Location"
                       class="form-control"
                       required />
            </div>

            <div class="mb-3">
                <label asp-for="DistanceKm" class="form-label">
                    Distance (km)
                </label>
                <input asp-for="DistanceKm"
                       type="number"
                       step="0.01"
                       min="0.01"
                       class="form-control"
                       required />
            </div>

            <div class="mb-3">
                <label asp-for="EventType" class="form-label">
                    Event Type
                </label>

                <select asp-for="EventType"
                        class="form-select"
                        required>
                    <option value="Running">Running</option>
                    <option value="Cycling">Cycling</option>
                    <option value="Swimming">Swimming</option>
                    <option value="Walking">Walking</option>
                </select>
            </div>

            <hr />

            <h5 class="mb-3">Event Banner</h5>

            @if (!string.IsNullOrEmpty(Model.EventBannerUrl))
            {
                <div class="mb-3">
                    <p>Current event banner:</p>

                    <img src="@Model.EventBannerUrl"
                         alt="Current Event Banner"
                         class="img-fluid rounded shadow"
                         style="max-height: 250px;" />
                </div>
            }
            else
            {
                <p class="text-muted">
                    No event banner has been uploaded yet.
                </p>
            }

            <div class="mb-3">
                <label class="form-label">
                    Upload a New Banner (Optional)
                </label>

                <input type="file"
                       name="eventBanner"
                       id="eventBanner"
                       class="form-control"
                       accept="image/*"
                       onchange="previewBanner(this)" />

                <small class="text-muted">
                    Leave empty to keep the existing banner.
                    Maximum size: 5 MB.
                </small>
            </div>

            <div class="mb-3">
                <img id="bannerPreview"
                     src="#"
                     alt="New Banner Preview"
                     class="img-fluid rounded shadow"
                     style="max-height: 250px; display: none;" />
            </div>

            <button type="submit" class="btn btn-primary">
                Save Changes
            </button>

        </form>

    </div>

</div>

<script>
    function previewBanner(input) {
        const preview = document.getElementById("bannerPreview");

        if (input.files && input.files[0]) {
            const file = input.files[0];

            if (!file.type.startsWith("image/")) {
                alert("Please select a valid image.");
                input.value = "";
                preview.style.display = "none";
                return;
            }

            if (file.size > 5 * 1024 * 1024) {
                alert("Image must not exceed 5 MB.");
                input.value = "";
                preview.style.display = "none";
                return;
            }

            preview.src = URL.createObjectURL(file);
            preview.style.display = "block";
        }
        else {
            preview.style.display = "none";
        }
    }
</script>
