@model RaceDayMVC.Models.CreateResultViewModel

@{
    ViewData["Title"] = "Add Race Result";
}

<div class="container mt-5">
    <h1>Add Race Result</h1>
    <p class="text-muted">Record a participant's finishing position and time.</p>

    <div class="card shadow-sm mt-4">
        <div class="card-body">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }

            @if (Model.Enrolments == null || !Model.Enrolments.Any())
            {
                <div class="alert alert-warning">
                    No enrolled participants are available for your events yet.
                </div>
            }
            else
            {
                <form asp-controller="Organiser"
                      asp-action="CreateResult"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="EnrolmentId" class="form-label">
                            Select Participant and Event
                        </label>

                        <select asp-for="EnrolmentId" class="form-select">
                            <option value="">-- Select an enrolment --</option>

                            @foreach (var enrolment in Model.Enrolments)
                            {
                                <option value="@enrolment.EnrolmentId">
                                    @enrolment.ParticipantName -
                                    @enrolment.EventName -
                                    @enrolment.CategoryName
                                </option>
                            }
                        </select>

                        <span asp-validation-for="EnrolmentId"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FinishingPosition" class="form-label">
                            Finishing Position
                        </label>

                        <input asp-for="FinishingPosition"
                               type="number"
                               min="1"
                               class="form-control"
                               placeholder="Example: 1" />

                        <span asp-validation-for="FinishingPosition"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FinishTime" class="form-label">
                            Finish Time
                        </label>

                        <input asp-for="FinishTime"
                               type="time"
                               step="1"
                               class="form-control" />

                        <span asp-validation-for="FinishTime"
                              class="text-danger"></span>

                        <small class="text-muted">
                            Enter the time in hours, minutes and seconds.
                        </small>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        Save Result
                    </button>

                    <a asp-controller="Organiser"
                       asp-action="Results"
                       class="btn btn-secondary">
                        Cancel
                    </a>
                </form>
            }

        </div>
    </div>
</div>
